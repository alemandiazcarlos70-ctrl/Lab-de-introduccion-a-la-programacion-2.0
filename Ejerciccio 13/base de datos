from flask import Flask, request, jsonify, render_template_string, g
import sqlite3
import os

APP_NAME = "Inventario con Escaneo de Productos"
DB_NAME = "inventario_productos.db"

app = Flask(__name__)


# -------------------- BASE DE DATOS --------------------
def get_db():
    if "db" not in g:
        g.db = sqlite3.connect(DB_NAME)
        g.db.row_factory = sqlite3.Row
    return g.db


@app.teardown_appcontext
def close_db(exception):
    db = g.pop("db", None)
    if db is not None:
        db.close()


def init_db():
    db = sqlite3.connect(DB_NAME)
    cur = db.cursor()

    cur.execute("""
        CREATE TABLE IF NOT EXISTS productos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            codigo TEXT NOT NULL UNIQUE,
            nombre TEXT NOT NULL,
            categoria TEXT NOT NULL,
            precio REAL NOT NULL DEFAULT 0,
            stock INTEGER NOT NULL DEFAULT 0,
            descripcion TEXT
        );
    """)

    cur.execute("SELECT COUNT(*) FROM productos;")
    total = cur.fetchone()[0]

    if total == 0:
        demo = [
            ("7501001234567", "Coca Cola 600 ml", "Bebidas", 18.00, 25, "Refresco de cola."),
            ("7502001234568", "Pan Bimbo Mediano", "Panadería", 42.50, 14, "Pan de caja clásico."),
            ("7503001234569", "Leche Entera 1L", "Lácteos", 28.90, 30, "Leche entera pasteurizada."),
            ("7504001234570", "Sabritas Original", "Botanas", 19.50, 40, "Papas fritas saladas."),
            ("7505001234571", "Shampoo 700 ml", "Higiene", 64.90, 12, "Shampoo uso diario."),
        ]
        cur.executemany("""
            INSERT INTO productos (codigo, nombre, categoria, precio, stock, descripcion)
            VALUES (?, ?, ?, ?, ?, ?);
        """, demo)

    db.commit()
    db.close()


# -------------------- CONSULTAS --------------------
def fetch_all_products():
    db = get_db()
    cur = db.execute("SELECT * FROM productos ORDER BY id DESC;")
    return cur.fetchall()


def fetch_product_by_code(codigo):
    db = get_db()
    cur = db.execute("SELECT * FROM productos WHERE codigo = ?;", (codigo,))
    return cur.fetchone()


