    async function loadProducts() {
      const res = await fetch("/api/products");
      const data = await res.json();
      productsTable.innerHTML = data.products.map(p => `
        <tr>
          <td>${p.codigo}</td>
          <td>${p.nombre}</td>
          <td>${p.stock}</td>
        </tr>
      `).join("");
    }

    async function searchProduct(code) {
      const res = await fetch(`/api/product/${encodeURIComponent(code)}`);
      const data = await res.json();
      if (data.found) {
        const p = data.product;
        const txt = `Producto encontrado
----------------------------------------
ID: ${p.id}
Código: ${p.codigo}
Nombre: ${p.nombre}
Categoría: ${p.categoria}
Precio: $${Number(p.precio).toFixed(2)}
Stock: ${p.stock}
Descripción: ${p.descripcion || ""}`;
        setResult(txt);
        setProductInfo(txt);
        setStatus("Producto encontrado");
      } else {
        const txt = `Código detectado, pero no existe en la base de datos.

Código leído:
${code}`;
        setResult(txt);
        setProductInfo(txt);
        setStatus("Código no registrado");
      }
