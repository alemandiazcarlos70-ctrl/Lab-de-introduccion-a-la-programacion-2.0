@app.route("/api/products", methods=["GET"])
def api_products():
    rows = fetch_all_products()
    return jsonify({
        "products": [
            {
                "id": r["id"],
                "codigo": r["codigo"],
                "nombre": r["nombre"],
                "categoria": r["categoria"],
                "precio": r["precio"],
                "stock": r["stock"],
                "descripcion": r["descripcion"]
            }
            for r in rows
        ]
    })


@app.route("/api/product/<codigo>", methods=["GET"])
def api_product(codigo):
    row = fetch_product_by_code(codigo)
    if not row:
        return jsonify({"found": False})
    return jsonify({
        "found": True,
        "product": {
            "id": row["id"],
            "codigo": row["codigo"],
            "nombre": row["nombre"],
            "categoria": row["categoria"],
            "precio": row["precio"],
            "stock": row["stock"],
            "descripcion": row["descripcion"]
        }
    })


@app.route("/api/product", methods=["POST"])
def api_create_product():
    data = request.get_json(force=True, silent=True) or {}

    codigo = str(data.get("codigo", "")).strip()
    nombre = str(data.get("nombre", "")).strip()
    categoria = str(data.get("categoria", "")).strip()
    descripcion = str(data.get("descripcion", "")).strip()

    try:
        precio = float(data.get("precio", 0))
        stock = int(data.get("stock", 0))
    except ValueError:
        return jsonify({"error": "Precio o stock inválidos"}), 400

    if not codigo or not nombre or not categoria:
        return jsonify({"error": "Código, nombre y categoría son obligatorios"}), 400

    try:
        db = get_db()
        db.execute("""
            INSERT INTO productos (codigo, nombre, categoria, precio, stock, descripcion)
            VALUES (?, ?, ?, ?, ?, ?);
        """, (codigo, nombre, categoria, precio, stock, descripcion))
        db.commit()
        return jsonify({"ok": True})
    except sqlite3.IntegrityError:
        return jsonify({"error": "Ese código ya existe"}), 400
    except Exception as e:
        return jsonify({"error": str(e)}), 500


@app.route("/api/product/<int:product_id>", methods=["PUT"])
def api_update_product(product_id):
    data = request.get_json(force=True, silent=True) or {}

    codigo = str(data.get("codigo", "")).strip()
    nombre = str(data.get("nombre", "")).strip()
    categoria = str(data.get("categoria", "")).strip()
    descripcion = str(data.get("descripcion", "")).strip()

    try:
        precio = float(data.get("precio", 0))
        stock = int(data.get("stock", 0))
    except ValueError:
        return jsonify({"error": "Precio o stock inválidos"}), 400

    if not codigo or not nombre or not categoria:
        return jsonify({"error": "Código, nombre y categoría son obligatorios"}), 400

    try:
        db = get_db()
        db.execute("""
            UPDATE productos
            SET codigo = ?, nombre = ?, categoria = ?, precio = ?, stock = ?, descripcion = ?
            WHERE id = ?;
        """, (codigo, nombre, categoria, precio, stock, descripcion, product_id))
        db.commit()
        return jsonify({"ok": True})
    except sqlite3.IntegrityError:
        return jsonify({"error": "Ese código ya existe"}), 400
    except Exception as e:
        return jsonify({"error": str(e)}), 500


@app.route("/api/product/<int:product_id>", methods=["DELETE"])
def api_delete_product(product_id):
    try:
        db = get_db()
        db.execute("DELETE FROM productos WHERE id = ?;", (product_id,))
        db.commit()
        return jsonify({"ok": True})
    except Exception as e:
        return jsonify({"error": str(e)}), 500


