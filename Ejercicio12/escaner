from flask import Flask, render_template_string, request, jsonify
import socket
import threading
import webbrowser
import time

app = Flask(__name__)

# --- BASE DE DATOS DE PRODUCTOS ---
PRODUCTOS = {
    "7501031311309": {"nombre": "Coca Cola 600 ml", "precio": "$18 MXN"},
    "7501055300012": {"nombre": "Sabritas Original", "precio": "$20 MXN"},
    "7501006551044": {"nombre": "Leche Lala 1 L", "precio": "$25 MXN"},
    "123456789": {"nombre": "Producto de Prueba", "precio": "$99 MXN"},
}

def obtener_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
    except Exception:
        ip = "127.0.0.1"
    finally:
        s.close()
    return ip

IP_LOCAL = obtener_ip()

# --- INTERFAZ ÚNICA PARA CELULAR Y PC ---
HTML_FINAL = """
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Scanner Pro Walmart</title>
    <script src="https://unpkg.com/html5-qrcode"></script>
    <style>
        body { font-family: sans-serif; margin: 0; background: #0071ce; color: white; text-align: center; display: flex; flex-direction: column; height: 100vh; }
